# Names only — the values live on the Vultr VM (mode 0600), never here.
# Every value is empty on purpose: this file is committed.
#
# The exact file used on the VM is deploy/cloud-init.yml (see deploy/README).

# --- inference (Vultr Serverless Inference) --------------------------------
VULTRINFERENCE_API_KEY=
VULTRINFERENCE_BASE_URL=
VULTRINFERENCE_MODEL=
VULTRINFERENCE_VISION_MODEL=

# --- signing ---------------------------------------------------------------
SIGNEDORDERS_SIGNING_KEY_PATH=
SIGNEDORDERS_APPROVAL_KEY_PATH=

# --- the HTTP door ---------------------------------------------------------
SIGNEDORDERS_HOST=
SIGNEDORDERS_PORT=
SIGNEDORDERS_JOURNAL_PATH=
# The bearer key the AGENT must present to POST /orders.
SIGNEDORDERS_AGENT_KEY=
# The bearer key a HUMAN must present to approve or refuse an order.
SIGNEDORDERS_OPERATOR_KEY=

# --- sandbox ---------------------------------------------------------------
SIGNEDORDERS_SANDBOX_BACKEND=
SIGNEDORDERS_SANDBOX_IMAGE=
SIGNEDORDERS_SANDBOX_MEMORY=
SIGNEDORDERS_SANDBOX_CPUS=
SIGNEDORDERS_SANDBOX_PIDS_LIMIT=
SIGNEDORDERS_SANDBOX_TIMEOUT_SECONDS=
SIGNEDORDERS_SANDBOX_EGRESS_ALLOWLIST=

# --- quotas ----------------------------------------------------------------
SIGNEDORDERS_QUOTA_ORDERS_PER_WINDOW=
SIGNEDORDERS_QUOTA_WINDOW_SECONDS=
SIGNEDORDERS_QUOTA_ORDERS_PER_TASK=
SIGNEDORDERS_QUOTA_CPU_SECONDS_PER_TASK=
SIGNEDORDERS_QUOTA_BYTES_WRITTEN_PER_TASK=
SIGNEDORDERS_QUOTA_CONCURRENT_SANDBOXES=
SIGNEDORDERS_QUOTA_TOKENS_PER_TASK=

# --- approvals -------------------------------------------------------------
SIGNEDORDERS_APPROVAL_CHANNEL=
SIGNEDORDERS_APPROVAL_TTL_SECONDS=
