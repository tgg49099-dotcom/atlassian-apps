# ── Signed Orders — example configuration ──────────────────────────────────
#
# This file contains VARIABLE NAMES ONLY. Every value below is a placeholder.
# Never commit a real .env file: it is already listed in .gitignore.
#
# Copy to .env on the host and fill it in there, or export the variables from
# /etc/signedorders/env (mode 0600, owned by the service account).

# ── Vultr Serverless Inference (OpenAI-compatible) ─────────────────────────
# Base URL is fixed by the platform: https://api.vultrinference.com/v1
VULTRINFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Your Vultr Serverless Inference API key (from the Vultr console).
VULTRINFERENCE_API_KEY=
# Model used by the agent loop. See the live list:
# https://api.vultrinference.com/v1/models
VULTRINFERENCE_MODEL=qwen3.8-flash-next
# Model used to verify screenshots (vision).
VULTRINFERENCE_VISION_MODEL=qwen3.8-27b

# ── Signing ────────────────────────────────────────────────────────────────
# The Ed25519 PRIVATE key is generated on the host by `signedorders init-key`
# and stored outside the repository. The PUBLIC key is committed on purpose.
# Path to the private key file (mode 0600).
SIGNEDORDERS_SIGNING_KEY_PATH=/etc/signedorders/signing.key
# Path to the public key file (committed).
SIGNEDORDERS_PUBLIC_KEY_PATH=./keys/signing.pub

# ── Agent credentials ──────────────────────────────────────────────────────
# A key whose ONLY privilege is "request an order". Rotate per agent.
SIGNEDORDERS_AGENT_KEY=

# ── Sandbox backends ───────────────────────────────────────────────────────
# docker | microsandbox
SIGNEDORDERS_SANDBOX_BACKEND=docker
# Image used for a fresh sandbox.
SIGNEDORDERS_SANDBOX_IMAGE=ghcr.io/signed-orders/sandbox:latest
# Hard limits applied to every run.
SIGNEDORDERS_SANDBOX_MEMORY=256m
SIGNEDORDERS_SANDBOX_CPUS=1
SIGNEDORDERS_SANDBOX_PIDS_LIMIT=128
SIGNEDORDERS_SANDBOX_TIMEOUT_SECONDS=30
# Comma-separated egress allowlist. Empty = no outbound access at all.
SIGNEDORDERS_SANDBOX_EGRESS_ALLOWLIST=

# ── Quotas ─────────────────────────────────────────────────────────────────
SIGNEDORDERS_QUOTA_ORDERS_PER_MINUTE=10
SIGNEDORDERS_QUOTA_ORDERS_PER_TASK=40
SIGNEDORDERS_QUOTA_CPU_SECONDS_PER_TASK=120
SIGNEDORDERS_QUOTA_BYTES_WRITTEN_PER_TASK=1048576
SIGNEDORDERS_QUOTA_CONCURRENT_SANDBOXES=2
SIGNEDORDERS_QUOTA_TOKENS_PER_TASK=200000

# ── Approvals ──────────────────────────────────────────────────────────────
# web (built-in, no third-party account needed) | telegram | slack
SIGNEDORDERS_APPROVAL_CHANNEL=web
# Only needed if the channel is telegram or slack. Optional, leave empty otherwise.
SIGNEDORDERS_TELEGRAM_BOT_TOKEN=
SIGNEDORDERS_TELEGRAM_CHAT_ID=
SIGNEDORDERS_APPROVAL_TTL_SECONDS=900

# ── Service ────────────────────────────────────────────────────────────────
SIGNEDORDERS_HOST=0.0.0.0
SIGNEDORDERS_PORT=8000
SIGNEDORDERS_JOURNAL_PATH=/var/lib/signedorders/journal.jsonl
SIGNEDORDERS_DB_PATH=/var/lib/signedorders/signedorders.db
# Policy file: the auditable risk rules.
SIGNEDORDERS_POLICY_PATH=./policy/policy.yaml
