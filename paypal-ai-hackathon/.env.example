# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and
# is NEVER committed. No variable below has a default value on purpose.
#
# The secrets are read by the Node server (src/server.ts) only. They are never
# sent to the browser: the front-end talks to the local API routes
# (/api/snapshot, /api/analyze) and never sees a credential.
# ---------------------------------------------------------------------------

# --- PayPal (sandbox, free) -------------------------------------------------
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- AI provider (optional) -------------------------------------------------
# Option A: any OpenAI-compatible endpoint (OpenAI, Together, Groq, Ollama, ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Option B: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
